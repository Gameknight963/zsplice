<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>zsplice</RootNamespace>
		<LangVersion>default</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>zsplice</AssemblyName>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="MelonLoader">
			<HintPath>$(LoaderAssembliesPath)/MelonLoader.dll</HintPath>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(LoaderAssembliesPath)/0Harmony.dll</HintPath>
		</Reference>

	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Architecture.cs" />
		<Compile Include="Core.cs" />
		<Compile Include="delegates.cs" />
		<Compile Include="Extensions\NativeLibraryExtensions.cs" />
		<Compile Include="HarmonyStatus.cs" />
		<Compile Include="NativeHookBridge.cs" />
		<Compile Include="NativeMod.cs" />
		<Compile Include="RuntimeType.cs" />
		<Compile Include="ZModCtx.cs" />
		<Compile Include="ZModInfo.cs" />
		<Compile Include="ZSpliceContextSupport.cs" />
		<Content Include="Directory.Build.props" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="PolySharp" Version="1.17.1">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>
	
	<Target Name="DeployOutput" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
		<Error Condition="'$(GamePath)' == '' Or !Exists('$(GamePath)')" Text="Set GamePath to an existing game installation or disable DeployOnBuild." />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)/Plugins" SkipUnchangedFiles="true" />
	</Target>
</Project>
